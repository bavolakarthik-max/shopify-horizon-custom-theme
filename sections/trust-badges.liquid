{% comment %}
  Trust badges section
  Shows a row of icons + short text (free shipping, returns, etc.)
  Every text and color is editable in the theme editor via the schema below.
{% endcomment %}

<div
  class="trust-badges"
  style="--tb-bg: {{ section.settings.background_color }}; --tb-columns: {{ section.settings.columns }};"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="trust-badges__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <div class="trust-badges__grid">
    {%- for block in section.blocks -%}
      <div class="trust-badges__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <span class="trust-badges__icon">{{ block.settings.icon }}</span>
        {%- endif -%}

        <h3 class="trust-badges__title">{{ block.settings.title | escape }}</h3>

        {%- if block.settings.text != blank -%}
          <div class="trust-badges__text">{{ block.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .trust-badges {
    background: var(--tb-bg);
   padding: 80px 20px;
    text-align: center;
  }

  .trust-badges__heading {
    margin: 0 0 32px;
    font-size: 28px;
  }

  .trust-badges__grid {
    display: grid;
    grid-template-columns: repeat(var(--tb-columns), 1fr);
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .trust-badges__icon {
    display: block;
    font-size: 36px;
    margin-bottom: 12px;
  }

  .trust-badges__title {
    margin: 0 0 8px;
    font-size: 18px;
  }

  .trust-badges__text {
    font-size: 14px;
    opacity: 0.75;
  }

  .trust-badges__text p {
    margin: 0;
  }

  /* Phones: 2 badges per row */
  @media (max-width: 749px) {
    .trust-badges__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust badges",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why shop with us"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f5f5f5"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Badges per row (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free shipping"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>On orders over $75</p>"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "🚚", "title": "Free shipping", "text": "<p>On orders over $75</p>" } },
        { "type": "badge", "settings": { "icon": "↩️", "title": "30-day returns", "text": "<p>Easy, hassle-free returns</p>" } },
        { "type": "badge", "settings": { "icon": "🔒", "title": "Secure checkout", "text": "<p>Your payment info is protected</p>" } },
        { "type": "badge", "settings": { "icon": "⭐", "title": "Quality guaranteed", "text": "<p>Premium fabrics, built to last</p>" } }
      ]
    }
  ]
}
{% endschema %}